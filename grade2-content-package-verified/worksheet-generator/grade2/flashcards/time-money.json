{
"unit": "time-money",
"unitName": "Time and Money",
"number": 10,
"cards": [
{
"front": "Hour hand",
"back": "The short hand. It shows the hour.",
"example": "between 3 and 4 means after 3:00",
"kind": "vocabulary"
},
{
"front": "Minute hand",
"back": "The long hand. Each number is 5 minutes.",
"example": "on the 4 means 20 minutes",
"kind": "vocabulary"
},
{
"front": "AM",
"back": "Times from midnight to noon (a.m.).",
"example": "7:30 AM is in the morning",
"kind": "vocabulary"
},
{
"front": "PM",
"back": "Times from noon to midnight (p.m.).",
"example": "6:00 PM is in the evening",
"kind": "vocabulary"
},
{
"front": "Quarter past",
"back": "15 minutes after the hour.",
"example": "quarter past 2 is 2:15",
"kind": "vocabulary"
},
{
"front": "Half past",
"back": "30 minutes after the hour.",
"example": "half past 9 is 9:30",
"kind": "vocabulary"
},
{
"front": "Penny",
"back": "A coin worth 1 cent.",
"example": "1¢",
"kind": "vocabulary"
},
{
"front": "Nickel",
"back": "A coin worth 5 cents.",
"example": "5¢",
"kind": "vocabulary"
},
{
"front": "Dime",
"back": "A coin worth 10 cents.",
"example": "10¢",
"kind": "vocabulary"
},
{
"front": "Quarter",
"back": "A coin worth 25 cents.",
"example": "25¢",
"kind": "vocabulary"
},
{
"front": "Dollar",
"back": "100 cents. Write it with $.",
"example": "$1 = 100¢",
"kind": "vocabulary"
},
{
"front": "Cent sign",
"back": "The symbol ¢ written after an amount of cents.",
"example": "45¢",
"kind": "vocabulary"
},
{
"front": "Minute hand on the 7?",
"back": "35 minutes (count by 5s).",
"kind": "concept"
},
{
"front": "Hour hand just past 4, minute hand on 9?",
"back": "4:45",
"kind": "example"
},
{
"front": "Is lunch at noon AM or PM?",
"back": "PM. Noon starts PM.",
"kind": "misconception"
},
{
"front": "Value of 2 quarters, 1 dime, 3 pennies?",
"back": "25 + 25 + 10 + 3 = 63¢",
"kind": "example"
},
{
"front": "Is a nickel worth more than a dime?",
"back": "No. A dime (10¢) is worth more, even though it is smaller.",
"kind": "misconception"
},
{
"front": "Fewest coins for 40¢?",
"back": "1 quarter, 1 dime, 1 nickel.",
"kind": "strategy"
},
{
"front": "How do you write 6 dollars?",
"back": "$6",
"kind": "fact"
},
{
"front": "You have 75¢. How much more for $1?",
"back": "100 − 75 = 25¢",
"kind": "example"
},
