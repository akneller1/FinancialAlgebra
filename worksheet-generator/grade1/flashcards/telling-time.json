{
"unit": "telling-time",
"unitName": "Telling Time",
"number": 10,
"cards": [
{
"front": "Hour hand",
"back": "The short hand. It tells the hour.",
"example": "It points to 3 at 3 o'clock",
"kind": "vocabulary"
},
{
"front": "Minute hand",
"back": "The long hand. It tells the minutes.",
"example": "It points to 12 at o'clock",
"kind": "vocabulary"
},
{
"front": "O'clock",
"back": "Time to the hour, with 0 minutes.",
"example": "7 o'clock is 7:00",
"kind": "vocabulary"
},
{
"front": "Half past",
"back": "30 minutes after the hour.",
"example": "half past 4 is 4:30",
"kind": "vocabulary"
},
{
"front": "Analog clock",
"back": "A clock with a face and hands.",
"example": "the classroom clock",
"kind": "vocabulary"
},
{
"front": "Digital clock",
"back": "A clock that shows numbers only.",
"example": "9:30",
"kind": "vocabulary"
},
{
"front": "Half hour",
"back": "30 minutes.",
"example": "from 2:00 to 2:30",
"kind": "vocabulary"
},
{
"front": "At 6 o'clock, where is the minute hand?",
"back": "At the 12.",
"kind": "fact"
},
{
"front": "At half past 6, where is the minute hand?",
"back": "At the 6.",
"kind": "fact"
},
{
"front": "At half past 6, where is the hour hand?",
"back": "Between the 6 and the 7.",
"kind": "misconception"
},
{
"front": "Write half past 9 like a digital clock.",
"back": "9:30",
"kind": "example"
},
{
"front": "What does 11:00 mean?",
"back": "11 o'clock.",
"kind": "example"
},
{
"front": "1 hour after 3:00",
"back": "4:00",
"kind": "example"
},
{
"front": "Half an hour after 5:00",
"back": "5:30",
"kind": "example"
},
{
"front": "The hour hand is past 8 but not at 9. The minute hand is at 6.",
"back": "Half past 8, or 8:30. Not 9:30.",
"kind": "misconception"
},
{
