{
"unit": "measurement-conversions",
"unitName": "Measurement and Conversions",
"number": 7,
"cards": [
{
"front": "Convert",
"back": "Change a measurement to a different unit.",
"example": "3 feet = 36 inches",
"kind": "vocabulary"
},
{
"front": "Customary units",
"back": "Units used in the United States: inches, feet, yards, miles, ounces, pounds, cups, quarts, gallons.",
"example": "1 foot = 12 inches",
"kind": "vocabulary"
},
{
"front": "Metric units",
"back": "Units based on powers of 10: millimeters, meters, grams, liters.",
"example": "1 meter = 100 centimeters",
"kind": "vocabulary"
},
{
"front": "Length",
"back": "How long something is.",
"example": "a pencil is 18 centimeters long",
"kind": "vocabulary"
},
{
"front": "Weight / mass",
"back": "How heavy something is.",
"example": "a puppy weighs 12 pounds",
"kind": "vocabulary"
},
{
"front": "Capacity",
"back": "How much a container holds.",
"example": "a jug holds 1 gallon",
"kind": "vocabulary"
},
{
"front": "Kilo-",
"back": "A prefix meaning 1,000.",
"example": "1 kilometer = 1,000 meters",
"kind": "vocabulary"
},
{
"front": "Centi-",
"back": "A prefix meaning 1/100.",
"example": "1 centimeter = 0.01 meter",
"kind": "vocabulary"
},
{
"front": "Milli-",
"back": "A prefix meaning 1/1000.",
"example": "1 milliliter = 0.001 liter",
"kind": "vocabulary"
},
{
"front": "1 foot = ? inches",
"back": "12 inches",
"kind": "rule"
},
{
"front": "1 yard = ? feet",
"back": "3 feet",
"kind": "rule"
},
{
"front": "1 mile = ? feet",
"back": "5,280 feet",
"kind": "rule"
},
{
"front": "1 pound = ? ounces",
"back": "16 ounces",
"kind": "rule"
},
{
"front": "1 gallon = ? quarts",
"back": "4 quarts",
"kind": "rule"
},
{
"front": "1 quart = ? cups",
"back": "4 cups (and 1 pint = 2 cups)",
"kind": "rule"
},
{
"front": "1 kilogram = ? grams",
"back": "1,000 grams",
"kind": "rule"
},
{
"front": "1 meter = ? centimeters",
"back": "100 centimeters",
"kind": "rule"
},
{
"front": "Big unit to small unit: multiply or divide?",
"back": "Multiply — you need MORE of the small units.",
"kind": "concept"
},
{
"front": "5 centimeters = ? meters",
"back": "0.05 meter (divide by 100)",
"kind": "mental"
},
{
"front": "Kai says 48 inches = 576 feet. What went wrong?",
"back": "He multiplied. Inches to feet means divide: 48 ÷ 12 = 4 feet.",
"kind": "misconception"
},
